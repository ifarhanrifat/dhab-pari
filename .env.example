# ─────────────────────────────────────────────────────────────────────────
# Deploying this platform for another village
# ─────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Every NEXT_PUBLIC_* value below has a
# working default (Dhab Pari's), so a variable you leave out simply keeps the
# original — nothing breaks, it just says the wrong village name.
#
# Only identity lives here. Anything staff should change without a deploy —
# helpline wording, receipt notes, slip templates, bank details on documents —
# is in the Settings screen, backed by the site_settings table.
#
# Identity is env rather than database because page titles, the PWA manifest
# and the OpenGraph preview image are all produced at build time, before any
# database connection exists.

# ── Supabase (required — one project per village) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Village identity ─────────────────────────────────────────────────────
NEXT_PUBLIC_VILLAGE_NAME=Dhab Pari
NEXT_PUBLIC_VILLAGE_NAME_UR=ڈھاب پڑی
NEXT_PUBLIC_COMMITTEE_NAME=Water & Welfare Committee
NEXT_PUBLIC_COMMITTEE_NAME_UR=واٹر اینڈ ویلفیئر کمیٹی
NEXT_PUBLIC_TAGLINE_UR=

NEXT_PUBLIC_DISTRICT=Chakwal
NEXT_PUBLIC_PROVINCE=Punjab
NEXT_PUBLIC_LOCATION=
NEXT_PUBLIC_ESTABLISHED=2018
NEXT_PUBLIC_DOMAIN=dhabpari.com
NEXT_PUBLIC_EMAIL=info@dhabpari.org
NEXT_PUBLIC_OFFICE_HOURS=Mon-Sat: 9AM-2PM, Fri: 9AM-12PM

# ── Contact ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP=0333-5008575
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/923335008575
NEXT_PUBLIC_WHATSAPP_GROUP_LINK=
NEXT_PUBLIC_FACEBOOK_LINK=

# ── Payment details shown on the public site ─────────────────────────────
NEXT_PUBLIC_JAZZCASH=
NEXT_PUBLIC_JAZZCASH_NAME=
NEXT_PUBLIC_EASYPAISA=
NEXT_PUBLIC_EASYPAISA_NAME=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_BRANCH=

# ── Which parts of the system this village bought ────────────────────────
# Hides navigation and pages for modules a village does not run. This is a
# product switch, NOT a security boundary — data access is still controlled by
# roles and RLS in the database, and must stay that way. Turning a module off
# must never be the only thing standing between a user and somebody's money.
NEXT_PUBLIC_MODULE_WATER=true
NEXT_PUBLIC_MODULE_DONORS=true
NEXT_PUBLIC_MODULE_BUSINESS=false

# ── Optional integrations ────────────────────────────────────────────────
GEMINI_API_KEY=
