# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# Not just /.next/ — Finder's "Duplicate" leaves ".next 2", which slipped past
# the old rule and pushed a 245 MB Turbopack cache file at GitHub.
/.next*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# design files
/design

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template that documents how to deploy for another village
!.env.example

# vercel
.vercel

# supabase CLI local state (connection metadata, machine-specific)
/supabase/.temp
/supabase/.branches

# personal reference images, not part of the app
/references

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS iCloud Drive conflict copies.
# This project lives under ~/Documents, which iCloud syncs. When a path is
# written by two processes at once, iCloud cannot merge, so it keeps both and
# appends " 2", " 3". Build output produced dozens of these; three unreferenced
# source duplicates ("Header 2.tsx", "docTranslations 2.ts",
# "donorReceiptTotals 2.ts") reached a commit via `git add -A` before anyone
# noticed. Ignored so they cannot be committed again.
# Note: "design/stitch_dhab_pari_welfare_portal 2/" is deliberately tracked —
# it is the only unzipped copy of the design reference, not a conflict copy.
* [0-9]
* [0-9].*
* [0-9][0-9]
* [0-9][0-9].*
!design/stitch_dhab_pari_welfare_portal 2/
