<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- "Unable to resolve camera activity" — @capacitor/camera's Android
         side calls Intent#resolveActivity() against MediaStore's own
         image-capture action before launching it, and since API 30
         Android hides other apps' launchable activities from that call
         by default (package-visibility) unless this app explicitly
         declares it queries for them here. targetSdkVersion 36 (well
         past that cutoff) with no <queries> block at all meant
         resolveActivity() always came back null — a real camera app was
         always present, the OS just wouldn't let this app see it. This
         is a native manifest change: it only takes effect in a rebuilt
         APK, not the next web deploy. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Live position sharing for the vehicle marketplace's ride-matching
         feature. Fine+coarse are requested together (Android requires
         this); background is a separate, second prompt Android forces to
         come after — the geolocation code asks for it in that order.
         Foreground service + its location type are required from
         Android 14 onward for a background-geolocation plugin to keep
         tracking while the app isn't the one on screen. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Push notifications (ride requests, order/booking updates) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Already-used-by-the-web-app features that need a native
         permission once running inside a WebView shell instead of a
         browser tab: the AI product-photo scan (shops) and any future
         QR/barcode scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
</manifest>
